<?xml version="1.0" encoding="utf-8"?>
<!--
  Sonance for Android TV (ticket-3.xx-androidtv P2).
  minSdk 26 / targetSdk 35, versionCode and versionName are passed to aapt2 link by
  build-android.sh (from config.xml), and debuggable by its debug mode, so this file
  holds no version. targetSdk stays 35: at 36 Android 16 stops delivering KEYCODE_BACK (G9).
  The package id is permanent: changing it breaks upgrades.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.simmo.sonance">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      allowBackup=false plus data-extraction rules that exclude everything: localStorage holds
      the password, as on Tizen, so app data never leaves the device (ticket §5.2).
      enableOnBackInvokedCallback=false keeps BACK as a key event for the page (K2).
    -->
    <application
        android:label="Sonance"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Sonance"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false">

        <!-- Both would send data to Google; the app talks only to the user's server. -->
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <!-- configChanges: a configuration change must never recreate the activity and reload the app. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|locale|layoutDirection|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- B1: keeps Sonance playing in the background. Started only by the app itself. -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
